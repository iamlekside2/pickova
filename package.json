{
  "name": "pickova",
  "version": "1.0.0",
  "private": true,
  "description": "Pickova — Nigerian sneaker e-commerce platform. Pick your pair.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,yellow \"npm run dev -w @pickova/api\" \"npm run dev -w @pickova/web\"",
    "dev:api": "npm run dev -w @pickova/api",
    "dev:web": "npm run dev -w @pickova/web",
    "build": "npm run build -w @pickova/api && npm run build -w @pickova/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "npm run db:migrate -w @pickova/api",
    "db:seed": "npm run db:seed -w @pickova/api",
    "db:studio": "npm run db:studio -w @pickova/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
