// Pickova data model — PostgreSQL.
//
// Conventions
//  * Money is stored as integer kobo (₦1 = 100 kobo). Never floats.
//  * Orders snapshot everything they need (names, prices, address) so history
//    survives later product or address edits.
//  * Stock lives on Inventory, one row per size × colour variant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users & access ─────────────────────────────

/// Roles are a closed set enforced by the database. ADMIN has full access,
/// STAFF can run the store day-to-day, CUSTOMER is the default.
enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            Role      @default(CUSTOMER)
  isActive        Boolean   @default(true)
  /// Bumped on password change / logout-everywhere to invalidate issued JWTs.
  tokenVersion    Int       @default(0)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses      Address[]
  cart           Cart?
  orders         Order[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  resetTokens    PasswordResetToken[]
  statusEvents   OrderStatusEvent[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token emailed to the user; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Home")
  recipientName String
  phone         String
  state         String
  city          String
  line1         String
  instructions  String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ───────────────────────────────── Catalogue ─────────────────────────────────

/// Men, Women, Kids, Sports, Casual … A product can sit in several
/// (e.g. Men + Sports), so the relation is many-to-many.
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCategory[]

  @@index([isActive, sortOrder])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  description        String        @default("")
  /// Manufacturer brand or Pickova's own product label; optional.
  brand              String?
  /// Base SKU for the style; each variant carries its own full SKU.
  sku                String        @unique
  priceKobo          Int
  /// "Was" price shown struck through. Must be greater than priceKobo.
  compareAtPriceKobo Int?
  status             ProductStatus @default(DRAFT)
  isFeatured         Boolean       @default(false)
  isNewArrival       Boolean       @default(false)
  isBestSeller       Boolean       @default(false)
  /// Denormalised from APPROVED reviews only; zero until real reviews exist.
  ratingAverage      Float         @default(0)
  reviewCount        Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  categories    ProductCategory[]
  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([status, createdAt])
  @@index([status, isFeatured])
  @@index([status, isNewArrival])
  @@index([status, isBestSeller])
  @@index([priceKobo])
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  /// Cloudinary public id, so the asset can be replaced or deleted.
  publicId  String?
  alt       String   @default("")
  /// Optional: ties the photo to a colourway so the gallery can follow the picker.
  colourId  String?
  colour    Colour?  @relation(fields: [colourId], references: [id], onDelete: SetNull)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Size {
  id        String @id @default(cuid())
  /// e.g. "42". Unique together with the sizing system.
  label     String
  system    String @default("EU")
  sortOrder Int    @default(0)

  variants ProductVariant[]

  @@unique([system, label])
}

model Colour {
  id   String @id @default(cuid())
  name String @unique
  hex  String

  variants ProductVariant[]
  images   ProductImage[]
}

/// One purchasable unit: a product in a specific size and colour.
model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId            String
  size              Size     @relation(fields: [sizeId], references: [id])
  colourId          String
  colour            Colour   @relation(fields: [colourId], references: [id])
  sku               String   @unique
  /// Optional per-variant price (e.g. larger sizes); falls back to the product price.
  priceOverrideKobo Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, sizeId, colourId])
  @@index([productId])
  @@index([sizeId])
  @@index([colourId])
}

model Inventory {
  variantId         String         @id
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Units on hand. A CHECK constraint keeps this from ever going negative.
  quantity          Int            @default(0)
  lowStockThreshold Int            @default(3)
  updatedAt         DateTime       @updatedAt
}

// ───────────────────────────── Cart & wishlist ─────────────────────────────

model Cart {
  id           String   @id @default(cuid())
  /// Set for signed-in customers; guests are identified by sessionToken.
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?  @unique
  couponId     String?
  coupon       Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
}

// ───────────────────────────── Orders & payments ─────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                   String      @id @default(cuid())
  /// Human-friendly reference shown to customers, e.g. PKV-7F3K2Q9A.
  reference            String      @unique
  userId               String?
  user                 User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status               OrderStatus @default(PENDING_PAYMENT)

  // Buyer + delivery snapshot (guest checkout supported)
  customerName         String
  email                String
  phone                String
  deliveryState        String
  deliveryCity         String
  deliveryAddress      String
  deliveryInstructions String?

  subtotalKobo         Int
  deliveryFeeKobo      Int         @default(0)
  discountKobo         Int         @default(0)
  totalKobo            Int
  currency             String      @default("NGN")
  couponId             String?
  coupon               Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode           String?

  trackingCarrier      String?
  trackingNumber       String?
  trackingUrl          String?

  paidAt               DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]
  events   OrderStatusEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot at time of purchase
  productName   String
  sku           String
  sizeLabel     String
  colourName    String
  imageUrl      String?
  unitPriceKobo Int
  quantity      Int
  lineTotalKobo Int

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

/// Audit trail of every status change (who, when, why).
model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentStatus {
  INITIALIZED
  SUCCESS
  FAILED
  ABANDONED
  REFUNDED
}

model Payment {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        PaymentProvider @default(PAYSTACK)
  /// The transaction reference sent to the gateway. Unique = idempotency key.
  reference       String          @unique
  amountKobo      Int
  currency        String          @default("NGN")
  status          PaymentStatus   @default(INITIALIZED)
  channel         String?
  gatewayResponse String?
  /// Raw verified gateway payload, for reconciliation.
  raw             Json?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
}

/// Every webhook delivery is recorded once; the unique key makes replays no-ops.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  /// provider-specific identity, e.g. "charge.success:<reference>"
  eventKey    String
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventKey])
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id              String     @id @default(cuid())
  /// Stored upper-case.
  code            String     @unique
  description     String     @default("")
  type            CouponType
  /// PERCENT: 1–100. FIXED: amount in kobo.
  value           Int
  minSubtotalKobo Int        @default(0)
  maxDiscountKobo Int?
  startsAt        DateTime?
  expiresAt       DateTime?
  /// null = unlimited
  usageLimit      Int?
  usedCount       Int        @default(0)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  carts  Cart[]
  orders Order[]
}

// ───────────────────────────────── Reviews ─────────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1–5, enforced by a CHECK constraint.
  rating             Int
  title              String       @default("")
  body               String       @default("")
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
}

// ───────────────────────── Delivery, content & settings ─────────────────────────

/// Delivery fee per Nigerian state.
model DeliveryZone {
  id         String   @id @default(cuid())
  state      String   @unique
  feeKobo    Int
  etaMinDays Int      @default(1)
  etaMaxDays Int      @default(5)
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

enum BannerPlacement {
  ANNOUNCEMENT
  HERO
  PROMO
}

model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement
  title     String
  subtitle  String          @default("")
  imageUrl  String?
  ctaLabel  String?
  ctaHref   String?
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Key/value store settings (contact details, free-delivery threshold, …).
model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
