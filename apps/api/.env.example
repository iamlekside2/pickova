# Pickova API — copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=4000

# PostgreSQL. Local dev: `npm run db:start` gives you this exact URL.
DATABASE_URL="postgresql://pickova@127.0.0.1:5433/pickova_dev?schema=public"
# Separate database the test suite migrates, seeds and writes to.
TEST_DATABASE_URL="postgresql://pickova@127.0.0.1:5433/pickova_test?schema=public"

# Comma-separated list of storefront origins allowed by CORS / CSRF checks.
WEB_ORIGIN=http://localhost:3009

# Signs session cookies. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set when the API is served from a different subdomain than the storefront
# (e.g. ".pickova.com.ng"). Leave empty when the storefront proxies /api.
COOKIE_DOMAIN=

# First admin account, created by `npm run db:seed` when both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to "false" to skip the sample catalogue when seeding a real store.
SEED_SAMPLE_CATALOGUE=true

# Public storefront URL used for links inside emails (password reset, order
# confirmation). Defaults to the first WEB_ORIGIN.
PUBLIC_SITE_URL=

# Email (Resend — free tier is enough to start). Without a key, emails are
# printed to the API log in development and NOT sent in production.
RESEND_API_KEY=
# Must be a sender verified in Resend, e.g. "Pickova <hello@yourdomain>"
EMAIL_FROM="Pickova <onboarding@resend.dev>"

# ── Phase 4 (checkout) ──
# PAYSTACK_SECRET_KEY=sk_test_...
# ── Phase 5 (admin image uploads) ──
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
